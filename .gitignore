# ==============================================================================
# SIH-2026: Mine Subsidence Monitoring, Prediction & Early Warning System
# Root .gitignore for Monorepo (NestJS Backend, Next.js Dashboard, ML-Server)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example
!*.env.template
!.env.example
!.env.template

# Credentials, Private Keys & Certificates
*.pem
*.key
*.csr
*.pfx
*.p12
*.keystore

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnpm-store/
.npm
.node_repl_history

# ------------------------------------------------------------------------------
# 3. Build Outputs, Compilers & Bundlers
# ------------------------------------------------------------------------------
# TypeScript / NestJS / Webpack / Vite
dist/
*/dist/
build/
*/build/
out/
*/out/
*.tsbuildinfo
*.build.tsbuildinfo

# Next.js build output & cache
.next/
*/.next/

# Vercel
.vercel/

# Turbo & caching
.turbo/
.cache/
.parcel-cache/

# ------------------------------------------------------------------------------
# 4. Logs, Runtime Dumps & Diagnostics
# ------------------------------------------------------------------------------
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Application-specific log files
backend_logs*.txt
*_logs.txt
*_logs*.txt

# ------------------------------------------------------------------------------
# 5. Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
*/coverage/
*.lcov
.nyc_output/
.vitest/

# ------------------------------------------------------------------------------
# 6. Python & Machine Learning (ML-Server)
# ------------------------------------------------------------------------------
# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Bytecode & Caches
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so

# Python distribution & packaging
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python testing & linters
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.hypothesis/

# Jupyter Notebooks
.ipynb_checkpoints/
*-checkpoint.ipynb

# Machine Learning weights, checkpoints & large binary models
# (Train artifacts & models should be stored in S3/GCS or tracked via Git LFS/DVC)
*.pt
*.pth
*.onnx
*.safetensors
*.bin
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.npy
*.npz

# ML Experiment tracking runs & runtime logs
wandb/
mlruns/
.mlruns/
lightning_logs/
prediction_log.jsonl
*.jsonl

# Scratch test files & temporary evaluation exports
scratch*.py
test_export.csv
*_export.csv

# ------------------------------------------------------------------------------
# 7. Databases & Local Data
# ------------------------------------------------------------------------------
/data/
backend/data/

# SQLite & local embedded databases
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.rdb

# ------------------------------------------------------------------------------
# 8. Operating System Specific
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 9. IDEs & Editors
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains (IntelliJ, WebStorm, PyCharm, etc.)
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs swap and backup files
*.swp
*.swo
*~
.#*
\#*#

# ------------------------------------------------------------------------------
# 10. Temporary & Scratch Files
# ------------------------------------------------------------------------------
tmp/
temp/
scratch/
*.tmp
*.bak
